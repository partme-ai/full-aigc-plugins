{
  "name": "figcraft",
  "version": "0.1.0-dev.20261019.2",
  "description": "线框、设计系统、明暗主题令牌、原型流与开发交接；布局保持可编辑与自适应。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/figcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/figcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "figcraft",
    "creative-workflow",
    "development-release"
  ],
  "skills": "./skills/",
  "displayName": "FigCraft（设计稿编辑）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "figcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "FigCraft（设计稿编辑）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "FigCraft (Design Mockups)",
          "zh-CN": "FigCraft（设计稿编辑）"
        },
        "icon": "pencil",
        "server": "figcraft-editor",
        "resourceUri": "ui://figcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
