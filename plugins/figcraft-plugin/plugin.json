{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "figcraft",
  "version": "0.1.0-dev.20261019.2",
  "description": "线框、设计系统、明暗主题令牌、原型流与开发交接；布局保持可编辑与自适应。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/figcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/figcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "figcraft",
    "creative-workflow",
    "development-release"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "FigCraft（设计稿编辑）",
        "shortDescription": "线框、设计系统、主题令牌与原型交付",
        "longDescription": "Source-built FigCraft Web with same-session MCP editing and workspace file operations. Local development candidate; host acceptance remains separate.",
        "developerName": "Full AIGC Plugins",
        "category": "Creativity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/figcraft-plugin",
        "defaultPrompt": [
          "Create an editable FigCraft project from my assets"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    }
  }
}
