{
  "schema": "craft-scenario-playbooks/v1",
  "application": "figcraft",
  "id": "signed-bar-chart",
  "templateOnly": true,
  "execution": "LIMITED_NATIVE_AND_CODEX_SYNTHETIC_PASS",
  "steps": [
    {
      "command": "file.new",
      "params": {
        "name": "Signed net-change chart"
      },
      "purpose": "仅新文件时初始化；已有设计文件跳过",
      "newDocumentOnly": true
    },
    {
      "command": "node.create",
      "params": {
        "type": "frame",
        "name": "Net change chart",
        "x": 0,
        "y": 0,
        "width": 1280,
        "height": 1024,
        "props": {
          "fill": "#ffffff",
          "clip": true
        }
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "root"
    },
    {
      "command": "node.create",
      "params": {
        "type": "text",
        "name": "Chart title",
        "x": 144,
        "y": 64,
        "width": 960,
        "height": 48,
        "props": {
          "fontSize": 32,
          "fill": "#101828"
        },
        "parent": {
          "$ref": "root.id"
        },
        "text": "Net change by region (units)"
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "title"
    },
    {
      "command": "node.create",
      "params": {
        "type": "line",
        "name": "Zero baseline",
        "x": 144,
        "y": 680,
        "width": 960,
        "height": 0,
        "props": {
          "stroke": "#344054",
          "strokeWeight": 2
        },
        "parent": {
          "$ref": "root.id"
        }
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "baseline"
    },
    {
      "command": "node.create",
      "params": {
        "type": "rectangle",
        "name": "Bar/North",
        "x": 204,
        "y": 680,
        "width": 120,
        "height": 120,
        "props": {
          "fill": "#d92d20",
          "pluginData": {
            "scene": "signed-bar-chart",
            "category": "North",
            "value": "-20"
          }
        },
        "parent": {
          "$ref": "root.id"
        }
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "bar0"
    },
    {
      "command": "node.create",
      "params": {
        "type": "text",
        "name": "Value/North",
        "x": 164,
        "y": 808,
        "width": 200,
        "height": 32,
        "props": {
          "fontSize": 24,
          "textAlign": "center",
          "fill": "#101828"
        },
        "parent": {
          "$ref": "root.id"
        },
        "text": "-20"
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "value0"
    },
    {
      "command": "node.create",
      "params": {
        "type": "text",
        "name": "Category/North",
        "x": 164,
        "y": 856,
        "width": 200,
        "height": 32,
        "props": {
          "fontSize": 24,
          "textAlign": "center",
          "fill": "#101828"
        },
        "parent": {
          "$ref": "root.id"
        },
        "text": "North"
      },
      "purpose": "创建独立可编辑图层并绑定真实返回ID",
      "capture": "category0"
    },
    {
