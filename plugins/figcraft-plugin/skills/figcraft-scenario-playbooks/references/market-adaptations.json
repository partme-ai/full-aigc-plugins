    {
      "id": "metric-card-component",
      "title": "组件复用而非重复绘制",
      "sourceIds": [
        "figma/mcp-server-guide/figma-generate-library"
      ],
      "adaptation": "先确认只需一组指标卡还是完整设计系统；本任务只建立所需组件，再放实例展示数据。修改组件或实例之前取实际ID，避免把展示页当成组件库完成。",
      "taskCheck": "实例仍关联组件，数据差异在正确实例中，原有节点保持。",
      "capabilityBoundary": "不宣称Craft支持Figma发布库、全部变量作用域或Code Connect。",
      "existingRecipe": "skills/figcraft-scenario-playbooks/references/recipes.json",
      "recipe": {
        "id": "metric-card-component",
        "title": "复用指标卡组件",
        "category": "interface-design",
        "inputs": "320×180指标卡，标题、数值和变化说明，转换为本地组件。",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
