{
  "schema": "craft-scenario-playbooks/v1",
  "application": "deckcraft",
  "id": "slide-redesign",
  "execution": "LIMITED_TECHNICAL_PASS",
  "steps": [
    {
      "purpose": "明确源页并复制；读取实际新增页与对象编号",
      "command": "slide.duplicate",
      "params": {
        "index": "$source.index"
      },
      "capture": "copy"
    },
    {
      "purpose": "查询副本的对象类型、文本、边框并绑定新ID",
      "command": "slide.inspect",
      "params": {
        "index": "$copy.index"
      }
    },
    {
      "purpose": "进入副本，保持后续命令属于此页",
      "command": "slide.go",
      "params": {
        "index": "$copy.index"
      }
    },
    {
      "purpose": "为副本选择标题正文布局",
      "command": "slide.layout",
      "params": {
        "index": "$copy.index",
        "layout": "titleAndContent"
      }
    },
    {
      "purpose": "定位副本titleId",
      "command": "shape.move",
      "params": {
        "ids": [
          "$copy.titleId"
        ],
        "x": 48,
        "y": 36
      }
    },
    {
      "purpose": "调整副本可编辑文字框，不拉伸图像",
      "command": "shape.resize",
      "params": {
        "ids": [
          "$copy.titleId"
        ],
        "w": 864,
        "h": 80,
        "lockAspect": false
      }
    },
    {
      "purpose": "定位副本bodyId",
      "command": "shape.move",
      "params": {
        "ids": [
          "$copy.bodyId"
        ],
        "x": 48,
        "y": 150
      }
    },
    {
      "purpose": "调整副本可编辑文字框，不拉伸图像",
      "command": "shape.resize",
      "params": {
        "ids": [
          "$copy.bodyId"
        ],
        "w": 540,
        "h": 300,
        "lockAspect": false
      }
    },
    {
      "purpose": "定位副本metricId",
      "command": "shape.move",
      "params": {
        "ids": [
          "$copy.metricId"
        ],
        "x": 630,
        "y": 150
      }
    },
    {
      "purpose": "调整副本可编辑文字框，不拉伸图像",
      "command": "shape.resize",
      "params": {
        "ids": [
          "$copy.metricId"
        ],
        "w": 280,
        "h": 120,
        "lockAspect": false
      }
    }
  ],
  "check": "源页及无关页保持一致；只修改新增副本，所有对象使用副本新ID，保留文字及目标边框。",
  "boundary": "先绑定source.index；复制后用slide.inspect查询副本，并按对象类型/文本唯一定位copy.titleId/bodyId/metricId。示例边框适用960×540页；真实尺寸按当前页重算。图片、图表不得按文字框规则拉伸。新建示例仅用于新任务：已有演示文稿先读取页数、选择和内容；不得用file.new清空。索引为0起，仅在此新文稿示例固定；已有文稿重新查询。布局和真实内容质量、外部PowerPoint渲染、宿主同步不由命令通过证明。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。",
  "validation": {
    "run": "https://github.com/partme-ai/full-aigc-plugins/actions/runs/39014846480",
    "sceneSourceCommit": "49d40a6b73930f267aff0b6e93909635dc1092d4",
    "platform": "Windows x64",
    "visualAcceptance": "NOT_TESTED",
    "installedHostSync": "NOT_TESTED"
  }
}
