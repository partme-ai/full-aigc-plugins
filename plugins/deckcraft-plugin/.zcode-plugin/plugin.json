{
  "name": "deckcraft",
  "version": "0.1.0-dev.20261109.5",
  "description": "一句话生成可编辑演示文稿：路演、周报、培训和数据叙事，母版、版式与讲稿都能继续改。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "DeckCraft（演示文稿）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "deckcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "DeckCraft",
    "zh-CN": "DeckCraft（演示文稿）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "DeckCraft",
          "zh-CN": "DeckCraft（演示文稿）"
        },
        "icon": "presentation",
        "server": "deckcraft-editor",
        "resourceUri": "ui://deckcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
