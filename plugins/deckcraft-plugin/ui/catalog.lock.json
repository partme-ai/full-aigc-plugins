        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "List commands",
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "run_command",
      "title": "Run a command",
      "description": "Run any command by id with JSON parameters. This is how everything is done: slide.new, shape.insert, text.set, format.bold, shape.fill, design.theme, transition.set, animation.add, table.merge, edit.undo…",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command id from list_commands"
          },
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Parameters (see the command's params summary)"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Run a command",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "batch",
      "title": "Run several commands",
      "description": "Run commands in order; stops at the first error unless keepGoing. Returns each result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "id"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": {}
            }
          },
          "keepGoing": {
            "type": "boolean",
            "description": "Continue after errors"
          }
        },
        "required": [
          "commands"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
