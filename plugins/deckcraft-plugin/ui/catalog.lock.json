    {
      "name": "export",
      "title": "Export",
      "description": "Export slides: png/jpeg (one slide, or all with all:true), pptx, deckcraft, outline text, or pdf (slides, notes pages or handouts).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "all": {
            "type": "boolean",
            "description": "All slides (images)"
          },
          "dpi": {
            "type": "number",
            "description": "PDF: raster resolution of slide artwork, 36-600 (default 200)"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "pptx",
              "deckcraft",
              "outline",
              "pdf"
            ],
            "description": "Output format (default: from the path's extension)"
          },
          "frame": {
            "type": "boolean",
            "description": "PDF notes/handouts: thin frame around each slide (default true)"
          },
          "includeHidden": {
            "type": "boolean",
            "description": "PDF: include hidden slides (default false)"
          },
          "layout": {
            "type": "string",
            "enum": [
              "slides",
              "notes",
              "handouts"
            ],
            "description": "PDF page layout (default slides)"
          },
          "path": {
            "type": "string",
            "description": "Output path"
          },
          "perPage": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 6
              },
              {
                "type": "number",
                "const": 9
              }
            ],
            "description": "PDF handouts: slides per page (default 6)"
          },
          "scale": {
            "type": "number",
            "description": "Pixels per point for images (default 2)"
          },
          "slide": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Slide index for images"
          },
          "slides": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "PDF: slide indices to export (default all)"
          },
          "textLayer": {
            "type": "boolean",
            "description": "PDF: invisible text layer for search, select and copy (default true)"
          }
        },
        "required": [
          "path"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Export",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
