{
  "schema": "craft-scenario-playbooks/v1",
  "application": "printcraft",
  "id": "report-bookmarks",
  "title": "长报告层级书签",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "templateOnly": true,
  "sourceFiles": [
    "input.pdf"
  ],
  "steps": [
    {
      "command": "doc_info",
      "params": {
        "doc": 1
      },
      "purpose": "先核对页数、现有书签与确认的章节起始页"
    },
    {
      "command": "bookmark_add",
      "params": {
        "doc": 1,
        "title": "Report",
        "page": 1
      },
      "purpose": "创建已确认报告起点"
    },
    {
      "command": "bookmark_add",
      "params": {
        "doc": 1,
        "title": "Findings",
        "page": 2,
        "parent": [
          1
        ]
      },
      "purpose": "在真实父书签路径下建立章节"
    },
    {
      "command": "bookmark_add",
      "params": {
        "doc": 1,
        "title": "Appendix",
        "page": 3
      },
      "purpose": "建立独立附录入口"
    },
    {
      "command": "bookmark_list",
      "params": {
        "doc": 1
      },
      "purpose": "核对层级、标题与目标页"
    },
    {
      "command": "doc_save",
      "params": {
        "doc": 1,
        "path": "output/navigable-report.pdf",
        "full": true
      },
      "purpose": "完整另存交付副本，不覆盖源PDF"
    }
  ],
  "check": "另开输出用bookmark_list核对Report→Findings层级及1/2/3目标页，独立PDF解释器读取目录，原页文本和源文件摘要不变。",
  "boundary": "章节页码必须由当前PDF及用户目录确认。parent是书签位置路径，不是页面编号；有既有书签先盘点，不能盲目追加重名目录。不是自动识别标题或无障碍认证。",
  "argumentPolicy": "doc/other是sourceFiles中1起始逻辑槽，仅用于随技能编译器生成的全新CLI脚本；MCP必须替换成当前doc_open实际返回ID。页号1起始，路径和坐标按真实输入替换，保持同一会话。"
}
