  "adaptations": [
    {
      "id": "pdf-preflight",
      "title": "文本与视觉双路核查",
      "sourceIds": [
        "openai/skills/pdf",
        "community-access/accessibility-agents/pdf-remediator"
      ],
      "adaptation": "先读页数、页面尺寸和文本层，再逐页渲染检查裁切、缺字、表格和顺序。把结构缺陷与视觉缺陷分开列出，自动修不了的交回源文档处理。",
      "taskCheck": "文本存在且实际页面可读，未检查的标签和阅读顺序明确列出。",
      "capabilityBoundary": "不能由text_extract成功推导PDF/UA、PDF/A或PDF/X合规。",
      "existingRecipe": "skills/pdfcraft-pdf-preflight/references/craft-steps.json",
      "recipe": {
        "schema": "craft-scenario-playbooks/v1",
        "application": "printcraft",
        "id": "pdf-preflight",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "读取文档结构",
            "command": "doc_info",
            "params": {
              "doc": 1
            }
          },
          {
            "purpose": "检查代表页渲染",
            "command": "page_render",
            "params": {
              "doc": 1,
              "page": 1,
              "dpi": 144
            }
          },
          {
            "purpose": "抽取文本看字体映射",
            "command": "text_extract",
            "params": {
              "doc": 1
            }
          },
          {
            "purpose": "检查表单字段完整性",
            "command": "form_fields",
            "params": {
              "doc": 1
            }
          }
        ],
        "check": "按要求核对每页尺寸、字体、文本、图像与书签，文件可打开不代表印前合规。",
        "boundary": "该流程不自动认证PDF/X、PDF/A或可访问性标准；对应标准需当前真实检测工具。",
        "templateOnly": true,
        "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    }
  ],
