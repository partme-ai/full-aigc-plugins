{
  "name": "pdfcraft",
  "version": "0.1.0-dev.20261109.2",
  "description": "Page reordering, OCR for scans, form filling, redaction and preflight. Originals are preserved and every page is checked for order, geometry and searchable text.",
  "license": "Apache-2.0",
  "repository": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "homepage": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "skills": "./skills/",
  "displayName": "PdfCraft",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "pdfcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "PdfCraft",
    "zh-CN": "PdfCraft"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "PdfCraft",
          "zh-CN": "PdfCraft"
        },
        "icon": "file-text",
        "server": "pdfcraft-editor",
        "resourceUri": "ui://pdfcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
