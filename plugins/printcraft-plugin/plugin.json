{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pdfcraft",
  "version": "0.1.0-dev.20261109.2",
  "description": "Page reordering, OCR for scans, form filling, redaction and preflight. Originals are preserved and every page is checked for order, geometry and searchable text.",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "PdfCraft · PDF Toolkit",
        "shortDescription": "Page cleanup, OCR, forms, redaction and preflight",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "org.full-aigc.pdfcraft": {
      "contracts": {
        "execution": "pdfcraft.execution/1",
        "verification": "pdfcraft.verification/1",
        "ocr": "pdfcraft.ocr/1",
        "ocrBackend": "pdfcraft.ocr-backend/1"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "PrintCraft"
    }
  },
  "repository": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "homepage": "https://github.com/full-aigc-plugins/pdfcraft-plugin"
}
