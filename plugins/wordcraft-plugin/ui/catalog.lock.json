{
  "tools": [
    {
      "name": "open_editor",
      "description": "Open WordCraft's interactive editor. Optionally load a file inside the current workspace. This opens the UI; it does not automate editing commands.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Workspace-relative file path",
            "type": "string",
            "maxLength": 4096
          },
          "workspace": {
            "type": "string",
            "description": "Absolute workspace path; set before opening an editor session."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://wordcraft/panel.html",
          "surface": "editor",
          "visibility": [
            "model",
            "app"
          ]
        },
        "openai/ui": {
          "preferredModelDisplayMode": "fullscreen"
        }
      }
    },
    {
      "name": "list_commands",
      "title": "List commands",
      "description": "Every WordCraft command: id, label, ribbon location, shortcut and params. Filter with `query`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Case-insensitive filter on id/label/location"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "List commands",
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "execute",
      "title": "Run a command",
      "description": "Run one command by id with params, e.g. {command:\"format.bold\"} or {command:\"insert.table\", params:{rows:3, cols:4}}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command id"
          },
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Command parameters"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Run a command",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "batch",
      "title": "Run several commands",
      "description": "Run commands in order; stops at the first error unless keepGoing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": {}
            }
          },
          "keepGoing": {
            "type": "boolean"
          }
        },
        "required": [
          "commands"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Run several commands",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "new_document",
