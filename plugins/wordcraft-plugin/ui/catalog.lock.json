  "resources": [
    {
      "name": "panel",
      "uri": "ui://wordcraft/panel.html",
      "mimeType": "text/html;profile=mcp-app",
      "_meta": {
        "ui": {
          "prefersBorder": false
        }
      }
    },
    {
      "name": "assets",
      "uri": "ui://wordcraft/assets.json",
      "mimeType": "application/json"
    }
  ],
  "resourceTemplates": [
    {
      "name": "asset-chunks",
      "uriTemplate": "ui://wordcraft/asset/{id}/{part}"
    },
    {
      "name": "file-chunks",
      "uriTemplate": "ui://wordcraft/file/{id}/{part}"
    }
  ]
}
