{
  "name": "soundcraft",
  "version": "0.1.0-dev.20261109.4",
  "description": "口播清理、多人响度、配音混音、剪辑与循环拼接，按段落和静音区间处理。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "SoundCraft",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "soundcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "SoundCraft",
    "zh-CN": "SoundCraft"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "SoundCraft",
          "zh-CN": "SoundCraft"
        },
        "icon": "music",
        "server": "soundcraft-editor",
        "resourceUri": "ui://soundcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
