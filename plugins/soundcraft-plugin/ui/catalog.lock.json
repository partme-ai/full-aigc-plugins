  "resources": [
    {
      "name": "panel",
      "uri": "ui://soundcraft/panel.html",
      "mimeType": "text/html;profile=mcp-app",
      "_meta": {
        "ui": {
          "prefersBorder": false
        },
        "zcode/csp": {
          "wasmUnsafeEval": true
        }
      }
    },
    {
      "name": "assets",
      "uri": "ui://soundcraft/assets.json",
      "mimeType": "application/json"
    }
  ],
  "resourceTemplates": [
    {
      "name": "asset-chunks",
      "uriTemplate": "ui://soundcraft/asset/{id}/{part}"
    },
    {
      "name": "file-chunks",
      "uriTemplate": "ui://soundcraft/file/{id}/{part}"
    }
  ]
}
