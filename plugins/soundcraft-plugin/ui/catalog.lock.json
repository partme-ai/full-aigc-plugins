{
  "tools": [
    {
      "name": "open_editor",
      "description": "Open SoundCraft's interactive editor. Optionally load a file inside the current workspace. This opens the UI; it does not automate editing commands.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Workspace-relative file path",
            "type": "string",
            "maxLength": 4096
          },
          "workspace": {
            "type": "string",
            "description": "Absolute workspace path; set before opening an editor session."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://soundcraft/panel.html",
          "surface": "editor",
          "visibility": [
            "model",
            "app"
          ]
        },
        "openai/ui": {
          "preferredModelDisplayMode": "fullscreen"
        }
      }
    },
    {
      "name": "list_commands",
      "description": "List SoundCraft commands (id, label, menu path, shortcut, params doc, enabled).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "description": "substring of id or label"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "execute",
      "description": "Run one command by id with JSON params. Returns the command's result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "batch",
      "description": "Run several commands in order; stops at the first error unless keep_going.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              },
              "additionalProperties": {}
            }
          },
          "keep_going": {
            "type": "boolean"
          }
        },
        "required": [
          "calls"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "inspect_session",
      "description": "The whole session as JSON: tracks (clips, inserts, sends, automation), busses, markers, groups, selection, transport.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
