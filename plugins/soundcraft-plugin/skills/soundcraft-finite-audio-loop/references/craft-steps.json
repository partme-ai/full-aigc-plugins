{
  "schema": "craft-scenario-playbooks/v1",
  "application": "soundcraft",
  "id": "finite-audio-loop",
  "execution": "LIMITED_TECHNICAL_PASS",
  "steps": [
    {
      "purpose": "读取当前片段ID和整数采样长度",
      "command": "session.inspect",
      "params": {
        "detail": "full"
      }
    },
    {
      "purpose": "指定一个原片段，创建总共3份，含原片段",
      "command": "clip.loop",
      "params": {
        "clips": [
          "$source.clip"
        ],
        "count": 3
      }
    },
    {
      "purpose": "检查三份排列与实际总长",
      "command": "session.inspect",
      "params": {
        "detail": "full"
      }
    },
    {
      "purpose": "输出明确时长的24位审核混音",
      "command": "file.bounce_mix",
      "params": {
        "path": "loop-review.wav",
        "format": "wav",
        "bit_depth": 24,
        "start": {
          "seconds": 0
        },
        "end": {
          "seconds": 3
        },
        "normalize": false,
        "dither": false
      }
    }
  ],
  "check": "输入1秒/48000采样的片段变为总3份，start为0/48000/96000，长度各48000；输出3秒无缺口，保存重开采样一致；flatten可展开为3个普通片段。",
  "boundary": "SoundCraft count=3含原片段；Audacity Number of repeats to add=3则额外加3份，两者不能照抄。循环不自动保证无爆音或节奏对齐；不为凑时长改变用户已确认素材速度。",
  "templateOnly": true,
  "argumentPolicy": "$变量和capture为手工绑定说明；从实际查询替换真实ID，不能直接发送这些模板记号。"
}
