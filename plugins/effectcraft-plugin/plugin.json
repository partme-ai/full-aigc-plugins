{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "effectcraft",
  "version": "0.1.0-dev.20261018.5",
  "description": "做可编辑动态图形：合成、关键帧、表达式、摄像机、遮罩与跟踪，渲染设置完整保留。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/effectcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/effectcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "effectcraft",
    "creative-workflow",
    "development-release"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "EffectCraft（动态图形）",
        "shortDescription": "做可编辑动态图形：合成、关键帧、表达式、摄像机、遮罩与跟踪，渲染设置完整保留。",
        "longDescription": "Use independently maintained, checksummed skills to install official CLIs and create editable native projects. Development release; complete capability and host acceptance remain in progress.",
        "developerName": "Full AIGC Plugins",
        "category": "Creativity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/effectcraft-plugin",
        "defaultPrompt": [
          "Create an editable EffectCraft project from my assets"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "EffectCraft"
    }
  }
}
