{
  "name": "effectcraft",
  "version": "0.1.0-dev.20261018.5",
  "description": "合成、关键帧、表达式、摄像机、遮罩与跟踪；图层、遮罩与渲染设置完整保留。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/effectcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/effectcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "effectcraft",
    "creative-workflow",
    "development-release"
  ],
  "skills": "./skills/",
  "displayName": "EffectCraft（动态图形）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "effectcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "EffectCraft（动态图形）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "EffectCraft (Motion Graphics)",
          "zh-CN": "EffectCraft（动态图形）"
        },
        "icon": "clapperboard",
        "server": "effectcraft-editor",
        "resourceUri": "ui://effectcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
