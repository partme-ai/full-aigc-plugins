{
  "schema": "craft-scenario-playbooks/v1",
  "application": "gridcraft",
  "id": "dashboard",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立供图表使用的汇总表",
      "command": "range.setValues",
      "params": {
        "range": "F1",
        "values": [
          [
            "周期",
            "数量"
          ],
          [
            "上期",
            21
          ],
          [
            "本期",
            42
          ]
        ]
      }
    },
    {
      "purpose": "插入可编辑趋势图",
      "command": "insert.chart",
      "params": {
        "range": "F1:G3",
        "type": "line",
        "title": "数量趋势",
        "at": "I2"
      }
    },
    {
      "purpose": "读取图表来源核对口径",
      "command": "sheet.read",
      "params": {
        "range": "F1:G3"
      }
    }
  ],
  "check": "图表数据源、单位与统计周期清楚，刷新后没有硬编码旧值。",
  "boundary": "示例汇总必须换成真实数据或公式；看板不能只交付静态截图。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
