{
  "schema": "craft-scenario-playbooks/v1",
  "application": "gridcraft",
  "id": "formula-audit",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "查看公式原文",
      "command": "sheet.read",
      "params": {
        "range": "A1:H100",
        "formulas": true
      }
    },
    {
      "purpose": "列出计算错误",
      "command": "formulas.errorChecking",
      "params": {}
    },
    {
      "purpose": "追查关键结果的引用",
      "command": "formulas.tracePrecedents",
      "params": {
        "cell": "H2"
      }
    },
    {
      "purpose": "分步求值验证",
      "command": "formulas.evaluateFormula",
      "params": {
        "cell": "H2"
      }
    }
  ],
  "check": "检查范围遗漏、相对绝对引用与手工常量，并记录修正前后数值。",
  "boundary": "不以无错误码证明公式业务含义正确；跨表引用要与原始数据核对。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
