    {
      "name": "sort_range",
      "title": "Sort range",
      "description": "Sort a range by one or more columns. keys: [{\"column\":\"B\",\"order\":\"desc\"}, …] or just [\"B\"]. Without `range` the current region around the selection is sorted; header detection follows Excel unless `header` is given.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "header": {
            "type": "boolean",
            "description": "The first row is a header (kept in place)"
          },
          "keys": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Column letter, e.g. \"B\" (ascending)"
                },
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "description": "Column letter, e.g. \"B\""
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ],
                      "description": "Sort order"
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Sort levels, most significant first"
          },
          "range": {
            "type": "string",
            "description": "A1-style range, e.g. \"A1:D10\", \"B:B\", \"Sheet2!A1:C3\""
          }
        },
        "required": [
          "keys"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Sort range",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "filter",
      "title": "Filter",
      "description": "Filter rows by a column (turns on AutoFilter on the current region, or `range`, when needed). Give `values` (keep rows whose cell text is one of them), `custom` ({op:\">\", value:\"10\", op2?, value2?, and?}), `top` ({count, bottom?, percent?}), or clear:true to remove this column's filter.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blanks": {
            "type": "boolean",
            "description": "Also keep blank cells"
          },
          "clear": {
            "type": "boolean",
            "description": "Clear this column's filter"
          },
          "column": {
            "type": "string",
            "description": "Column letter, e.g. \"C\""
          },
          "custom": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Custom criteria: {op: \"=\"|\"<>\"|\">\"|\">=\"|\"<\"|\"<=\"|\"beginsWith\"|\"contains\"…, value, op2?, value2?, and?: bool}"
          },
          "range": {
            "type": "string",
            "description": "Data range to filter (default: the current region of the selection)"
          },
          "top": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Top/bottom N: {count, bottom?: bool, percent?: bool}"
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "description": "Values to keep"
          }
        },
        "required": [
          "column"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Filter",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
