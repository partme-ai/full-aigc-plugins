    {
      "name": "evaluate_formula",
      "title": "Evaluate formula",
      "description": "Evaluate a formula against the active sheet WITHOUT changing any cell, e.g. \"=SUM(B2:B10)/COUNT(B2:B10)\" or \"=VLOOKUP(\\\"x\\\",A:B,2,FALSE)\". `cell` sets the formula's position for relative references and ROW()/COLUMN().",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "string",
            "description": "Evaluate as if in this cell (default: active cell)"
          },
          "formula": {
            "type": "string",
            "description": "Formula text, with or without the leading ="
          }
        },
        "required": [
          "formula"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Evaluate formula",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "select",
      "title": "Select",
      "description": "Set the selection (what commands without a `range` param act on). Multiple areas with commas: \"A1:B2,D4\". A \"Sheet2!A1\" prefix switches sheets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "active": {
            "type": "string",
            "description": "Active cell inside the selection (default: top-left of the last area)"
          },
          "range": {
            "type": "string",
            "description": "A1-style range, e.g. \"A1:D10\", \"B:B\", \"Sheet2!A1:C3\""
          }
        },
        "required": [
          "range"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Select",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
