{
  "tools": [
    {
      "name": "open_editor",
      "description": "Open GridCraft's interactive editor. Optionally load a file inside the current workspace. This opens the UI; it does not automate editing commands.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Workspace-relative file path",
            "type": "string",
            "maxLength": 4096
          },
          "workspace": {
            "type": "string",
            "description": "Absolute workspace path; set before opening an editor session."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://gridcraft/panel.html",
          "surface": "editor",
          "visibility": [
            "model",
            "app"
          ]
        },
        "openai/ui": {
          "preferredModelDisplayMode": "fullscreen"
        }
      }
    },
    {
      "name": "execute_command",
      "title": "Execute command",
      "description": "Run ANY GridCraft command by id with JSON params — every ribbon/menu action is a command. Find ids and parameter docs with list_commands. Examples: {\"command\":\"cell.set\",\"params\":{\"cell\":\"B2\",\"input\":\"=SUM(A1:A9)\"}}; {\"command\":\"home.bold\",\"params\":{\"range\":\"A1:C1\"}}; {\"command\":\"sheet.insert\"}; {\"command\":\"data.removeDuplicates\",\"params\":{\"range\":\"A1:C20\"}}. Most commands act on the current selection when `range` is omitted. Programmatic calls never open dialogs: missing required params give an error.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command id, e.g. \"cell.set\", \"home.fillColor\", \"insert.chart\""
          },
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Command parameters (see the `params` field of list_commands); omit or {} for defaults"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Execute command",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_commands",
      "title": "List commands",
      "description": "List GridCraft commands: id, label, ribbon path, shortcut, a parameter description (`params`) and whether it can run right now. Use it to discover what execute_command can do (e.g. search \"sort\", \"border\", \"chart\", \"sheet\").",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Case-insensitive substring matched against id, label and ribbon path"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "List commands",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "inspect_workbook",
      "title": "Inspect workbook",
      "description": "Summary of the active workbook: title, path, dirty flag, sheets (name, used range, cell count, tables, charts, merges, filters, freeze panes), defined names, current selection and active cell, calculation mode and undo/redo history.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Inspect workbook",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_range",
      "title": "Read range",
      "description": "Read cell values from a range as rows (2-D array). Numbers/booleans/strings are returned as JSON values, empty cells as null, errors as {\"error\":\"#DIV/0!\"}. Without `range`, reads the sheet's used range. formulas:true returns formula text (\"=SUM(B2:B4)\") for formula cells; formatted:true returns the displayed text (\"$1,234.00\", \"12%\").",
      "inputSchema": {
        "type": "object",
        "properties": {
          "formatted": {
            "type": "boolean",
            "description": "Return display text with number formats applied"
          },
          "formulas": {
            "type": "boolean",
            "description": "Return formulas instead of computed values for formula cells"
          },
          "range": {
            "type": "string",
            "description": "A1-style range, e.g. \"A1:D10\", \"B:B\", \"Sheet2!A1:C3\""
          },
          "sheet": {
            "type": "string",
            "description": "Sheet name (default: the active sheet)"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Read range",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "write_range",
      "title": "Write range",
      "description": "Write a 2-D array of values starting at the top-left cell of `range` (rows of cells). Numbers, booleans, null (clears) and strings are accepted; strings starting with = are formulas (\"=SUM(B2:B4)\"), other strings are parsed like typed input (\"12%\", \"1/2/2024\", \"$5\"). One undo step. Example: {\"range\":\"A1\",\"values\":[[\"Item\",\"Cost\"],[\"Rent\",1200]]}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "description": "Top-left cell or range, e.g. \"A1\" or \"Sheet2!B3\""
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "description": "Rows of cell values"
          }
        },
        "required": [
          "range",
          "values"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Write range",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "set_cell",
      "title": "Set cell",
      "description": "Enter one cell exactly as if typed: a number, text, or a formula starting with = (\"=AVERAGE(B2:B9)\"). Dependent cells recalculate. Returns the command result; use get_cell to read the computed value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "string",
            "description": "Cell, e.g. \"B7\" or \"Sheet2!C3\""
          },
          "input": {
            "description": "Typed input: number, text or =formula",
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "required": [
          "cell",
          "input"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Set cell",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_cell",
      "title": "Get cell",
      "description": "Details of one cell: computed value and type, formula, display text, raw input, spill range, style, merge, comment and hyperlink.",
