    {
      "name": "format_range",
      "title": "Format range",
      "description": "Apply several formats to a range in one call: bold, italic, underline, font name/size, font color, fill color, number format, horizontal alignment, wrap, borders. Colors are \"#RRGGBB\" (fontColor also \"auto\", fillColor also \"none\"). numberFormat is a name (General, Number, Currency, Accounting, Comma, Percentage, Short Date, Long Date, Time, Fraction, Scientific, Text) or a format code (\"#,##0.00\", \"0%\", \"yyyy-mm-dd\"). Each property runs one command; the result lists them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bold": {
            "type": "boolean",
            "description": "Bold on/off"
          },
          "borders": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "bottom",
                  "top",
                  "left",
                  "right",
                  "none",
                  "all",
                  "outside",
                  "thickOutside",
                  "thickBottom",
                  "doubleBottom",
                  "topBottom",
                  "topThickBottom",
                  "topDoubleBottom",
                  "insideHorizontal",
                  "insideVertical",
                  "inside",
                  "diagonalDown",
                  "diagonalUp"
                ],
                "description": "Border preset"
              },
              {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string",
                    "description": "Border color \"#RRGGBB\""
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "bottom",
                      "top",
                      "left",
                      "right",
                      "none",
                      "all",
                      "outside",
                      "thickOutside",
                      "thickBottom",
                      "doubleBottom",
                      "topBottom",
                      "topThickBottom",
                      "topDoubleBottom",
                      "insideHorizontal",
                      "insideVertical",
                      "inside",
                      "diagonalDown",
                      "diagonalUp"
                    ],
                    "description": "Border preset"
                  },
                  "style": {
                    "type": "string",
                    "description": "thin|medium|thick|dashed|dotted|double|hair…"
                  }
                },
                "required": [
                  "preset"
                ],
                "additionalProperties": false
              }
            ],
            "description": "A border preset name, or {preset, style?, color?}"
          },
          "fillColor": {
            "type": "string",
            "description": "Background color \"#RRGGBB\" or \"none\""
          },
          "fontColor": {
            "type": "string",
            "description": "Text color \"#RRGGBB\" or \"auto\""
          },
          "fontName": {
            "type": "string",
            "description": "Font family, e.g. \"Calibri\""
          },
          "fontSize": {
            "type": "number",
            "minimum": 1,
            "maximum": 409,
            "description": "Font size in points"
          },
          "horizontalAlign": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right",
              "justify"
            ],
            "description": "Horizontal alignment"
          },
          "italic": {
            "type": "boolean",
            "description": "Italic on/off"
          },
          "numberFormat": {
            "type": "string",
            "description": "Number format name or code"
          },
          "range": {
            "type": "string",
            "description": "A1-style range, e.g. \"A1:D10\", \"B:B\", \"Sheet2!A1:C3\""
          },
          "underline": {
            "type": "boolean",
            "description": "Single underline on/off"
          },
          "wrapText": {
            "type": "boolean",
            "description": "Wrap text on/off"
          }
        },
        "required": [
          "range"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Format range",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
