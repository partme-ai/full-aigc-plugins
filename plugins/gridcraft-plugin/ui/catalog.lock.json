            "description": "Variant (optional)"
          },
          "title": {
            "type": "string",
            "description": "Chart title"
          },
          "type": {
            "type": "string",
            "enum": [
              "column",
              "bar",
              "line",
              "pie",
              "doughnut",
              "area",
              "scatter",
              "bubble",
              "radar",
              "combo",
              "histogram",
              "waterfall",
              "funnel",
              "treemap",
              "sunburst",
              "boxWhisker",
              "stock"
            ],
            "description": "Chart type"
          }
        },
        "required": [
          "range",
          "type"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Insert chart",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
