{
  "name": "gridcraft",
  "version": "0.1.0-dev.20261109.3",
  "description": "Budgets, reconciliation, table cleanup, sales summaries and formula audits. Values keep their units and sources, and formulas stay recalculable.",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "GridCraft",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "gridcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "GridCraft",
    "zh-CN": "GridCraft"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "GridCraft",
          "zh-CN": "GridCraft"
        },
        "icon": "table",
        "server": "gridcraft-editor",
        "resourceUri": "ui://gridcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
