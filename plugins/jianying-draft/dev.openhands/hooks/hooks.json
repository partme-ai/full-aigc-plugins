{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/harness.mjs\" session-check",
            "timeout": 30,
            "statusMessage": "剪映编辑环境检查…"
          }
        ]
      }
    ]
  }
}
