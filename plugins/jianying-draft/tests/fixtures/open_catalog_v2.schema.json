{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-planning-catalog/v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "jianying-planning-catalog/v2"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "legacy_schema": {
          "const": "jianying-video-taxonomy/v1"
        },
        "legacy_seed_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "consumer_contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "legacy_schema",
        "legacy_seed_ids",
        "consumer_contracts"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "values"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "catalog_id",
    "revision",
    "compatibility",
    "dimensions",
    "domains",
    "overlays",
    "scenes",
    "recipes",
    "sources",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^scene\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "legacy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "domain_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "applies_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "not_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "asset_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "overlay_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "example_path": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "editorial_intent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published_knowledge",
            "test_fixture"
          ]
        }
      },
      "required": [
        "id",
        "legacy_ids",
        "name",
        "aliases",
        "tags",
        "domain_ids",
        "applies_when",
        "not_for",
        "asset_requirements",
        "primary_recipe_id",
        "overlay_ids",
        "example_path",
        "source_ids",
        "acceptance",
        "guardrails",
        "skills",
        "required_capabilities",
        "beats",
        "editorial_intent",
        "status"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "step_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optional_overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "goal",
        "conditions",
        "step_requirements",
        "optional_overlays",
        "conflicts",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "data_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "human_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "external_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "data_roles",
        "preconditions",
        "required",
        "capability_ids",
        "human_requirements",
        "external_requirements"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^\\s]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "accessed_on": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "access_scope": {
          "type": "string",
          "minLength": 1
        },
        "adaptation": {
          "type": "string",
          "minLength": 1
        },
        "popularity": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "measured",
                "popularity_unverified"
              ]
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "observed_on": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "metrics",
            "observed_on",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "query",
        "accessed_on",
        "access_scope",
        "adaptation",
        "popularity"
      ],
      "additionalProperties": false
    }
  }
}
