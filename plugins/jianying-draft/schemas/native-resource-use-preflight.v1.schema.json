{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-native-resource-use-preflight/v1",
  "type": "object",
  "required": ["schema", "request_id", "status", "domain", "resource_id", "usage", "channel", "checks", "requirement_digest", "candidate_digest"],
  "properties": {
    "schema": {"const": "jianying-native-resource-use-preflight/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"const": "ready"},
    "domain": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "usage": {"enum": ["personal", "commercial", "editorial"]},
    "channel": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "requirement_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
