{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-retarget-proposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_id", "workflow_id", "output_id", "from_revision", "to_revision", "from_target_digest", "proposed_target_digest", "proposed_reference_set_digest", "reason", "evidence_refs", "required_approval", "status", "metadata"],
  "properties": {
    "schema": {"const": "jianying-retarget-proposal/v1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "output_id": {"type": "string", "minLength": 1},
    "from_revision": {"type": "number"},
    "to_revision": {"type": "number"},
    "from_target_digest": {"$ref": "#/$defs/digest"},
    "proposed_target_digest": {"$ref": "#/$defs/digest"},
    "proposed_reference_set_digest": {"$ref": "#/$defs/digest"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_approval": {"const": "human_retarget"},
    "status": {"const": "proposed"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
