{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-macro-revision-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "workflow_id", "output_id", "from_revision", "to_revision", "stall_digest", "context_digest", "strategies", "reason_codes", "maximum_once", "required_approvals", "metadata"],
  "properties": {
    "schema": {"const": "jianying-macro-revision-request/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "output_id": {"type": "string", "minLength": 1},
    "from_revision": {"type": "number"},
    "to_revision": {"type": "number"},
    "stall_digest": {"$ref": "#/$defs/digest"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "strategies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["restructure_timeline", "replace_assets", "rebuild_pacing", "rework_audio", "reset_visual_style"]}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_once": {"const": true},
    "required_approvals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "human_macro_revision"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
