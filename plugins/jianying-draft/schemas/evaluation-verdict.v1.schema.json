{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-evaluation-verdict/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_id", "revision", "output_id", "input_digest", "evaluator", "decision", "evidence_refs", "scores", "hard_gates", "findings", "limitations", "metadata"],
  "properties": {
    "schema": {"const": "jianying-evaluation-verdict/v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "revision": {"type": "number"},
    "output_id": {"type": "string", "minLength": 1},
    "input_digest": {"$ref": "#/$defs/digest"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "decision": {"enum": ["pass", "revise", "blocked", "stop"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scores": {"type": "array", "items": {"$ref": "#/$defs/score"}},
    "hard_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "provider", "model", "version"],
      "properties": {
        "type": {"enum": ["human", "model", "deterministic"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "value", "passed"],
      "properties": {
        "dimension_id": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "passed": {"type": "boolean"}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "passed", "evidence_refs"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {"start_us": {"type": "number"}, "end_us": {"type": "number"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "output_id", "observation", "rule_id", "evidence_refs", "suggested_action"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "minor", "major", "critical"]},
        "output_id": {"type": "string", "minLength": 1},
        "time_range": {"$ref": "#/$defs/range"},
        "artifact_ref": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "suggested_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
