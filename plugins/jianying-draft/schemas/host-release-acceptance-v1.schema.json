{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.partme.ai/jianying/host-release-acceptance-v1.schema.json",
  "title": "JianYing three-host release acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "pluginVersion",
    "cliVersion",
    "skillsVersion",
    "jobSchema",
    "hosts"
  ],
  "properties": {
    "schema": {"const": "jianying-host-release-acceptance/v1"},
    "status": {"enum": ["pending", "passed"]},
    "pluginVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "cliVersion": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      ]
    },
    "skillsVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "jobSchema": {"const": "jianying-job/v2"},
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "evidencePath", "evidenceSha256"],
        "properties": {
          "host": {"enum": ["codex", "zcode", "kimi"]},
          "evidencePath": {
            "type": "string",
            "pattern": "^runtime/host-evidence/(codex|zcode|kimi)\\.json$"
          },
          "evidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pending"}}},
      "then": {"properties": {"hosts": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "cliVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "hosts": {"minItems": 3, "maxItems": 3}
        }
      }
    }
  ]
}
