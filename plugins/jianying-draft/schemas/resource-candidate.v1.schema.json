{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-resource-candidate/v1",
  "type": "object",
  "properties": {
    "schema": {"const": "jianying-resource-candidate/v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["media", "music", "text", "sticker", "effect", "transition", "caption", "smart_package", "filter", "adjustment", "template", "digital_human"]},
    "title": {"type": "string", "minLength": 1},
    "provider": {"const": "jianying_official"},
    "resource_id": {"type": "string", "minLength": 1},
    "edition": {"enum": ["basic", "professional", "unknown"]},
    "download_state": {"enum": ["not_downloaded", "downloading", "downloaded", "failed", "ambiguous"]},
    "styles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "moods": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tempos": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "aspect_ratios": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "channels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_usages": {"type": "array", "items": {"enum": ["personal", "commercial", "editorial"]}, "minItems": 1, "uniqueItems": true},
    "cost_microunits": {"type": "number"},
    "terms_reference": {"type": "string", "minLength": 1},
    "restrictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "preview_only": {"type": "boolean"},
    "rank": {"type": "number"},
    "limited_free_until_epoch_seconds": {"type": "number"},
    "duration_ms": {"type": "number"},
    "local_path": {"type": "string", "minLength": 1},
    "draft_path": {"type": "string", "minLength": 1},
    "draft_resource_id": {"type": "string", "minLength": 1},
    "failure_code": {"type": "string", "minLength": 1}
  },
  "required": ["schema", "candidate_id", "domain", "title", "provider", "resource_id", "edition", "download_state", "styles", "moods", "tempos", "aspect_ratios", "channels", "allowed_usages", "cost_microunits", "terms_reference", "restrictions", "preview_only", "rank"],
  "additionalProperties": false
}
