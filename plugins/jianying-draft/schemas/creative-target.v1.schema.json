{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-creative-target/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_id", "workflow_id", "revision", "narrative_goal", "audience", "channel", "target_duration_us", "references", "constraints", "quality_profiles", "metadata"],
  "properties": {
    "schema": {"const": "jianying-creative-target/v1"},
    "target_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "revision": {"type": "number"},
    "narrative_goal": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "target_duration_us": {"type": "number"},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constraint"}},
    "quality_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileRef"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "type", "artifact_digest", "usage"],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["video", "image", "audio", "text"]},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "usage": {"type": "string", "minLength": 1}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "kind", "value", "source_status", "source_ref"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["must_keep", "must_avoid"]},
        "value": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user_confirmed", "observed", "inferred_pending_review"]},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "profileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["output_id", "profile_id", "version", "digest"],
      "properties": {
        "output_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
