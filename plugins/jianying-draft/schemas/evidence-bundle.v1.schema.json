{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-evidence-bundle/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_id", "revision", "output_id", "artifact_digest", "items", "conclusion", "metadata"],
  "properties": {
    "schema": {"const": "jianying-evidence-bundle/v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "revision": {"type": "number"},
    "output_id": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "conclusion": {"enum": ["passed", "failed", "incomplete", "blocked"]},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "type", "digest", "validator", "environment", "observed_at", "passed", "artifact_ref", "limitations"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["structural", "technical", "proxy", "creative", "cold_reopen", "playback", "native_export", "human_review"]},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validator": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "artifact_ref": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
