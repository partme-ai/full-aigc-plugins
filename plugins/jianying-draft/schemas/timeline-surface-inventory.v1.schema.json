{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/jianying-timeline-surface-inventory-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observed_editor", "evidence", "coverage", "surfaces", "expansion_rule", "truth_rule"],
  "properties": {
    "schema": {"const": "jianying-timeline-surface-inventory/v1"},
    "observed_editor": {"$ref": "#/$defs/editor"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "expansion_rule": {"type": "string", "minLength": 1},
    "truth_rule": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "route": {"type": "string", "enum": ["draft_protocol", "runtime_native", "accessibility_adapter", "visual_fallback"]},
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "version", "build", "platform"],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "width", "height"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "width": {"type": "number"},
        "height": {"type": "number"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_surfaces", "regions"],
      "properties": {
        "expected_surfaces": {"type": "number"},
        "expandable_parents": {"type": "number"},
        "enumerated_parents": {"type": "number"},
        "regions": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "region", "visual_order", "label", "semantic_id", "status", "route", "fallback_route", "parameters", "evidence"],
      "properties": {
        "surface_id": {"type": "string", "minLength": 1},
        "parent_surface_id": {"type": "string", "minLength": 1},
        "accessibility_name": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "visual_order": {"type": "number"},
        "label": {"type": "string", "minLength": 1},
        "semantic_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["mapped", "unresolved"]},
        "route": {"$ref": "#/$defs/route"},
        "fallback_route": {"$ref": "#/$defs/route"},
        "parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "string", "minLength": 1},
        "expansion": {"$ref": "#/$defs/expansion"}
      }
    },
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "child_surface_ids", "evidence"],
      "properties": {
        "kind": {"enum": ["menu", "dropdown", "popover", "context_menu"]},
        "status": {"enum": ["pending_accessibility", "partial", "enumerated"]},
        "child_surface_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
