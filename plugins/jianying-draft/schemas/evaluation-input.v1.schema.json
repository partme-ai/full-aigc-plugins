{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-evaluation-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_id", "revision", "output_id", "target_digest", "profile_digest", "artifacts", "evidence", "content_review", "evaluator_scope", "metadata"],
  "properties": {
    "schema": {"const": "jianying-evaluation-input/v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "revision": {"type": "number"},
    "output_id": {"type": "string", "minLength": 1},
    "target_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "content_review": {"$ref": "#/$defs/content_review"},
    "evaluator_scope": {"$ref": "#/$defs/scope"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "type", "digest", "bytes"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["draft", "proxy_media", "native_media", "keyframes", "audio_facts", "captions", "transcript"]},
        "digest": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "number"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "type", "artifact_id", "digest", "role"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "role": {"enum": ["technical", "context_only", "fact"]},
        "language": {"type": "string", "minLength": 1}
      }
    },
    "review_status": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["absent", "unconfirmed", "confirmed"]},
        "artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "language_status": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "status"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "status": {"enum": ["not_required", "unconfirmed", "confirmed"]}
      }
    },
    "content_review": {
      "type": "object", "additionalProperties": false,
      "required": ["captions", "transcript", "languages"],
      "properties": {
        "captions": {"$ref": "#/$defs/review_status"},
        "transcript": {"$ref": "#/$defs/review_status"},
        "languages": {"type": "array", "items": {"$ref": "#/$defs/language_status"}}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "maximum_cost", "upload_allowed"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "maximum_cost": {"type": "number"},
        "upload_allowed": {"type": "boolean"}
      }
    }
  }
}
