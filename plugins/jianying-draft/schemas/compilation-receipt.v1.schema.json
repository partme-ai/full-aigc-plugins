{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-compilation-receipt/v1",
  "type": "object",
  "properties": {
    "schema": {"const": "jianying-compilation-receipt/v1"},
    "compiler": {"type": "object", "additionalProperties": true},
    "plan_digest": {"type": "string", "minLength": 64},
    "catalog_ref": {"type": "object", "additionalProperties": true},
    "cli": {"type": "object", "additionalProperties": true},
    "semantic_digest": {"type": "string", "minLength": 64},
    "execution_digest": {"type": "string", "minLength": 64},
    "job_digests": {"type": "array", "items": {"type": "string", "minLength": 64}},
    "quality_contracts": {"type": "object", "additionalProperties": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema", "compiler", "plan_digest", "catalog_ref", "cli", "semantic_digest", "execution_digest", "job_digests", "warnings"],
  "additionalProperties": false
}
