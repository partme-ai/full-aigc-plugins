{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jianying-video-intent/v1",
  "type": "object",
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "jianying-video-intent/v1"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}$"
    },
    "query": {
      "type": "string"
    },
    "delivery": {
      "enum": [
        "plan",
        "structural",
        "proxy_preview",
        "native_export"
      ]
    },
    "channel": {
      "enum": [
        "custom",
        "short_vertical",
        "long_horizontal",
        "private_event",
        "course",
        "ad"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_features": {
      "type": "array",
      "items": {
        "enum": [
          "asr",
          "tts",
          "transitions",
          "auto_caption_verification"
        ]
      }
    }
  }
}
