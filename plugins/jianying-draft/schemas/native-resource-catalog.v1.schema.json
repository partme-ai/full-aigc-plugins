{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-native-resource-catalog/v1",
  "$defs": {
    "editionObservation": {
      "type": "object",
      "properties": {
        "schema": {"const": "jianying-native-edition-observation/v1"},
        "application": {
          "type": "object",
          "properties": {
            "display_name": {"type": "string", "minLength": 1},
            "bundle_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "required": ["display_name", "bundle_id", "version"],
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {"login_state": {"enum": ["logged_in", "logged_out", "unknown"]}},
          "required": ["login_state"],
          "additionalProperties": false
        },
        "account": {
          "type": "object",
          "properties": {
            "edition": {"enum": ["basic", "professional", "unknown"]},
            "status": {"enum": ["active", "expired", "inactive", "unknown"]},
            "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "source": {"const": "gui_observed"},
            "observed_at": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "minLength": 1}
          },
          "required": ["edition", "status", "capabilities", "source", "observed_at"],
          "additionalProperties": false
        },
        "observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["schema", "application", "session", "account", "observation_digest"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "editor_identity", "edition_observation", "adapter_identity", "domains", "unknown_domains", "catalog_digest"],
  "properties": {
    "schema": {"const": "jianying-native-resource-catalog/v1"},
    "editor_identity": {"type": "object", "additionalProperties": true},
    "edition_observation": {"$ref": "#/$defs/editionObservation"},
    "adapter_identity": {"type": "object", "additionalProperties": true},
    "domains": {
      "type": "array", "minItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain", "status", "actions", "candidates", "evidence"],
        "properties": {
          "domain": {"enum": ["media", "music", "text", "sticker", "effect", "transition", "caption", "filter", "adjustment", "template"]},
          "status": {"enum": ["available", "unavailable", "unresolved"]},
          "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "candidates": {"type": "array", "items": {"type": "object"}},
          "evidence": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "unknown_domains": {"type": "array", "items": {"type": "object"}},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
