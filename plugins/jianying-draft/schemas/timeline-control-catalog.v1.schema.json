{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/jianying-timeline-control-catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "editor_scope", "observed_editor", "route_priority", "controls", "truth_rule"],
  "properties": {
    "schema": {"const": "jianying-timeline-control-catalog/v1"},
    "editor_scope": {"type": "string", "minLength": 1},
    "observed_editor": {"$ref": "#/$defs/editor"},
    "route_priority": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/route"}},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}},
    "truth_rule": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "route": {"type": "string", "enum": ["draft_protocol", "runtime_native", "accessibility_adapter", "visual_fallback"]},
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "bundle_id", "version", "build", "platform"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "bundle_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "state_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "input", "readback", "readback_required"],
      "properties": {
        "operation": {"type": "string", "enum": ["set", "invoke"]},
        "input": {"type": "string", "minLength": 1},
        "readback": {"type": "string", "minLength": 1},
        "readback_required": {"const": true}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "label", "route", "fallback_route", "status", "capability", "command", "parameters", "state_scope", "evidence"],
      "properties": {
        "semantic_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/route"},
        "fallback_route": {"$ref": "#/$defs/route"},
        "status": {"type": "string", "enum": ["supported", "partial", "unresolved"]},
        "capability": {"type": "string", "minLength": 1},
        "command": {},
        "parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "state_contract": {"$ref": "#/$defs/state_contract"},
        "state_scope": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
