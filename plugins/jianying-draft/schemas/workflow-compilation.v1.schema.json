{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-workflow-compilation/v1",
  "type": "object",
  "properties": {
    "schema": {"const": "jianying-workflow-compilation/v1"},
    "plan_digest": {"type": "string", "minLength": 64},
    "can_compile": {"type": "boolean"},
    "can_execute": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "job_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "receipt": {"type": "object", "additionalProperties": true}
  },
  "required": ["schema", "plan_digest", "can_compile", "can_execute", "blockers", "job_bindings", "receipt"],
  "additionalProperties": false
}
