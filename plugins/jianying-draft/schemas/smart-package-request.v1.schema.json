{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jianying-smart-package-request/v1",
  "type": "object",
  "required": ["schema", "request_id", "workflow_id", "style", "input_assets", "allowed_tracks", "protected_content", "budget", "preview", "maximum_duration_ms", "request_digest"],
  "properties": {
    "schema": {"const": "jianying-smart-package-request/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "label", "route_tags"], "properties": {
      "operation_id": {"enum": ["smart_package", "smart_b_roll", "smart_rough_cut", "script_rough_cut"]},
      "label": {"type": "string", "minLength": 1},
      "route_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
    }},
    "style": {"type": "object", "additionalProperties": true},
    "input_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "allowed_tracks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "protected_content": {"type": "object", "additionalProperties": false, "required": ["dialogue_ids", "brand_claim_ids", "segment_ids"], "properties": {
      "dialogue_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "brand_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "segment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }},
    "budget": {"type": "object", "additionalProperties": false, "required": ["currency", "maximum"], "properties": {"currency": {"type": "string"}, "maximum": {"type": "number"}}},
    "preview": {"type": "object", "additionalProperties": false, "required": ["required", "human_approval_required"], "properties": {"required": {"const": true}, "human_approval_required": {"const": true}}},
    "maximum_duration_ms": {"type": "number"},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["stages", "failure_recovery"], "properties": {
      "stages": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["plan", "preview", "approve", "apply", "verify"]}},
      "failure_recovery": {"type": "object", "additionalProperties": false, "required": ["snapshot_before_apply", "ambiguous_apply", "verification_failure"], "properties": {
        "snapshot_before_apply": {"const": true},
        "ambiguous_apply": {"const": "restore"},
        "verification_failure": {"const": "restore"}
      }}
    }},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
